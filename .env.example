# Optional. To enable SEC EDGAR, provide a client/organization name and one monitored contact email.
# Example format: <your real organization or software name> <your monitored contact email>
# The app checks format only; it cannot verify that the identity is truthful or monitored.
# SEC_USER_AGENT=

# Yahoo Finance access is disabled unless explicitly enabled by the operator.
# Enable only after written authorization covers this adapter, datasets, display,
# audience, and intended use. This flag is a technical switch, not permission.
# TSRP_YAHOO_FINANCE_ENABLED=false

# Required for server-side signing of company facts used in user scenarios (at least 32 random bytes).
# `openssl rand -hex 32` is suitable; generate independently for each environment.
# Never expose or commit it.
# TSRP_SCENARIO_SIGNING_SECRET=

# Required in production to pin same-origin API requests to the deployed site.
# Example: https://your-project.vercel.app
# APP_ORIGIN=

# Shared by Next.js and Python; also signs research data stored in browser snapshots.
# Changing it invalidates old signed score snapshots. Keep it server-side in both runtimes.
# TSRP_API_TOKEN_SECRET=generate-a-different-random-secret-of-at-least-32-bytes

# Optional local-development override only. Must be an http://127.0.0.1:<port> origin;
# Next.js proxies /api/* through the same origin. Defaults to http://127.0.0.1:8000.
# TSRP_DEV_API_ORIGIN=http://127.0.0.1:8000

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend/",
      "framework": "python",
      "functions": {
        "api/analyze.py": { "maxDuration": 30 },
        "api/scenario.py": { "maxDuration": 30 },
        "api/search.py": { "maxDuration": 20 },
        "api/snapshot_diff.py": { "maxDuration": 10 },
        "api/movers.py": { "maxDuration": 30 },
        "api/top_stocks.py": { "maxDuration": 30 }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
